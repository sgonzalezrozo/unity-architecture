{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(bash scripts/verify.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-on-stop.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
