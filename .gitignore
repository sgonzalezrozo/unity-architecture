# Only unity/, the Unity package, needs .meta files; the rest is Markdown and tools.
*.meta

# OS files
.DS_Store
Thumbs.db

# .NET build output
bin/
obj/

# The Unity package keeps its .meta files, so its GUIDs are the same in every project.
!unity/**/*.meta
!unity/*.meta

# The Rules Guide content: Unity skips folders ending in ~, but git must keep them
# (a global *~ ignore would otherwise drop them).
!unity/KnowledgeDocs~/
!unity/KnowledgeDocs~/**
